# --- Kaggle ---
# Chọn MỘT trong hai cách xác thực.
# Cách 1 (khuyến nghị, token mới ở https://www.kaggle.com/settings/api):
KAGGLE_API_TOKEN=KGAT_...
# Cách 2 (API key cũ, `key` 32 ký tự hex trong kaggle.json):
#KAGGLE_USERNAME=your_kaggle_username
#KAGGLE_KEY=0123456789abcdef0123456789abcdef

# Luôn cần: dùng làm phần <owner> của dataset id, và tiền tố tên dataset.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_SLUG=vi-real-audio-demo-v1

# --- HuggingFace ---
# Bắt buộc cho phần FAKE: VieNeu-TTS-140h là dataset gated.
# Accept terms tại https://huggingface.co/datasets/pnnbao-ump/VieNeu-TTS-140h
# Token bắt đầu bằng hf_, lấy ở https://huggingface.co/settings/tokens
HF_TOKEN=

# Cổng dashboard theo dõi tiến độ
DASHBOARD_PORT=8000
